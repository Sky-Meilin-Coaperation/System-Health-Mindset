# ==========================================
# SkyOS Public Framework - Environment Template
# ==========================================
# Kopiere diese Datei in eine lokale `.env`-Datei (niemals committen!)
# und trage dort deine tatsächlichen Zugangsdaten ein.

# FastAPI Core Gateway Konfiguration
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# API-Schlüssel & Tokens (Platzhalter - niemals echte Keys hier eintragen!)
DISCORD_BOT_TOKEN=dein_discord_bot_token_hier
HF_TOKEN=dein_huggingface_token_hier

# Lokale Inferenz & LLM-Anbindung (z.B. LM Studio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
