# ==========================================
# SkyOS System & Operational Environment
# ==========================================

# 1. API & Externe Dienste
HF_TOKEN=your_huggingface_token_here

# 2. System-Protagonisten & Logging
LOG_LEVEL=INFO
APP_ENV=production

# 3. SkyOS Core & Manifest Konfiguration (Lokaler Modus ohne Docker-Zwang)
ENVIRONMENT=development
RUN_MODE=local
PYTHONUNBUFFERED=1

# 4. Manifest-Metadaten
PROJECT_NAME="Sky Meilin – Operationales System-Dashboard"
VERSION="1.0.0"

# 5. Infrastruktur-Ausrichtung (Zero-Cost & Local Orchestration)
INFRASTRUCTURE_MODE=local_python
DOCKER_ENABLED=false